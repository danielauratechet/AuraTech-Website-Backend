{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=auratech;Username=postgres;Password=postgres123"
  },
  "Observability": {
    "LogRequestResponseBodies": true,
    "MaxBodyLength": 32768
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithMachineName" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
